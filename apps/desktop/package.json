{
  "name": "@opencanvas/desktop",
  "version": "0.1.0",
  "description": "Evaluchat desktop Workspace (AI-off MVP)",
  "author": "Evaluchat <noreply@users.noreply.github.com>",
  "homepage": "https://github.com/evaluchat/evaluchat",
  "repository": "https://github.com/evaluchat/evaluchat",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "smoke": "xvfb-run -a electron out/main/index.js --smoke-test",
    "package:linux": "electron-builder --linux",
    "package:win": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --x64",
    "format": "prettier --config .prettierrc --write \"src\" \"*.ts\" \"*.yml\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --config .prettierrc --check \"src\" \"*.ts\" \"*.yml\" \"scripts/**/*.mjs\""
  },
  "dependencies": {
    "@blocknote/core": "^0.18.0",
    "@blocknote/react": "^0.18.0",
    "@blocknote/shadcn": "^0.18.0",
    "beautiful-mermaid": "^1.1.3",
    "clsx": "^2.1.1",
    "katex": "^0.16.0",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.4.20",
    "electron": "43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
