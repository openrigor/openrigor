  "homepage": "https://evaluchat.org",
  "repository": "https://github.com/evaluchat/evaluchat",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "yarn clean && tsc",
    "clean": "rm -rf ./dist .turbo || true",
    "format": "prettier --config .prettierrc --write \"src\"",
